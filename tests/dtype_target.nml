&dtype_nml
    dt_scalar%val = 1
    dt_stack%outer%inner = 2
    dt_vector%vec = 1, 2, 3
/

&dtype_multi_nml
    dt%x = 1
    dt%y = 2
    dt%z = 3
/

&dtype_nested_nml
    f%g%x = 1
    f%g%y = 2
    f%g%z = 3
/

&dtype_field_idx_nml
    f%x(1:3) = 1, 2, 3
/

&dtype_vec_nml
    a%b(1)%c = 1
    a%b(1)%d = 2
    a%b(2)%c = 3
    a%b(2)%d = 4
    a%b(3)%c = 5
    a%b(3)%d = 6
/

&dtype_sparse_vec_nml
    a%b(2)%c = 2
/

&dtype_single_value_vec_nml
    a(1)%b = 1
/

&dtype_single_vec_merge_nml
    a%b(1)%c = 1
    a%b(1)%d = 2
/

&dtype_list_ooo_noidx
    a(1)%i = 123
    a(2)%i = 456
    a(3)%i = 789
/

&dtype_vec_range_nml
    arr(1:2)%bar = 3.0, 4.0
    arr(1:2)%foo = 1.0, 2.0
/

&dtype_vec_open_range_nml
    var(1:2)%ele_name = 'P1_PIP5', 'M2_PIP0'
/

&dtype_vec_open_range_single_nml
    var(1)%ele_name = 'O_L1'
/

&dtype_vec_range_then_single_nml
    var(1)%low_lim = 0.001
    var(3)%low_lim = 0.001
    var(1:6)%attribute = 'p', 'q', 'r', 's', 't', 'u'
    var(1:6)%ele_name = 'a', 'b', 'c', 'd', 'e', 'f'
/

&dtype_positional_nml
    datum(1) = 'beta.a', '', '', 'M1', 'target', 4.5, 10.0
    datum(2) = 'alpha.a', '', '', 'M1', 'target', 6.7, 100.0
/

&dtype_positional_mixed_nml
    datum(1) = 'eta.x', '', 'M1', 'target', 1.2, 100.0
    datum(2)%data_type = 'expression: a - b'
    datum(2)%meas = 0.0
    datum(2)%weight = 1.0
    datum(3)%data_type = 'expression: c - d'
    datum(3)%meas = 0.0
    datum(3)%weight = 1.0
/

&dtype_positional_then_field_nml
    design_lattice(1) = 'bmad.lat'
    design_lattice(1)%dynamic_aperture_calc = .true.
/

&dtype_unindexed_positional_then_field_nml
    f = 'hello'
    f%x = 42
/

&dtype_scatter_over_dt_array_nml
    var(1)%ele_name = 'a'
    var(2)%ele_name = 'b'
    var(3)%ele_name = 'c'
    var(1:3)%attribute = 'k1', 'k2', 'k3'
/

&dtype_nested_parent_idx_nml
    arr(1)%inner%foo = 1.0
    arr(2)%inner%foo = 2.0
/

&dtype_nested_parent_idx_multi_nml
    arr(1)%inner%foo = 1.0
    arr(1)%inner%bar = 3.0
    arr(2)%inner%foo = 2.0
    arr(2)%inner%bar = 4.0
/

&dtype_triple_nested_parent_idx_nml
    arr(1)%a%b%c = 1.0
    arr(2)%a%b%c = 2.0
/

&dtype_mixed_flat_then_nested_nml
    arr(1)%inner%bar = 3.0
    arr(2)%inner%bar = 4.0
    arr(1:2)%foo = 1.0, 2.0
/

&dtype_strided_parent_idx_nml
    arr(1:5:2)%foo = 10.0, 30.0, 50.0
/

&dtype_scatter_partial_nml
    var(1)%x = 1
    var(2)%attr = 'a'
    var(3)%attr = 'b'
/

&dtype_scatter_irregular_nml
    var(2)%x = 2
    var(1)%attr = 'a'
    var(3)%attr = 'c'
    var(4)%attr = 'd'
/

&dtype_scatter_nested_nml
    var(1)%x = 1
    var(1)%inner%foo = 1.0
    var(2)%x = 2
    var(2)%inner%foo = 2.0
/

&dtype_open_start_parent_idx_nml
    arr(1)%inner%foo = 1.0
    arr(2)%inner%foo = 2.0
/

&dtype_positional_gap_nml
    datum(1) = 'a', 1
    datum(3) = 'b', 2
/
